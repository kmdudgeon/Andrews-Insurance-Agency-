# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.andrewsinsagency.net

# Supabase — the site builds and runs in preview mode without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 after enabling Web Analytics and Speed Insights in the Vercel project.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=
